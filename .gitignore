# ---------------------------------------------------------------- deps --
# Path-less, so it matches at any depth. `client/node_modules/` only ever
# matched that one folder — a third package anywhere else would be committed.
node_modules/

# ------------------------------------------------------------- secrets --
# Every variant, everywhere. `.env.local`, `.env.production` and friends all
# hold credentials; naming them one at a time is how one gets missed.
.env
.env.*
!.env.example

# ------------------------------------------------------------- outputs --
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------ uploaded --
# User content. Never source.
server/storage/
server/profilePictures/

# ---------------------------------------------------------------- logs --
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------ os --
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------------------- tools --
.vercel/
coverage/
.idea/
*.swp

# ---------------------------------------------------------------- local --
CLAUDE.md
